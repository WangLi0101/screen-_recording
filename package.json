{
  "name": "screenrec",
  "version": "0.1.0",
  "description": "Local-first screen recorder built with Electron, Vite 8 and React 19",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
